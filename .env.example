# Copy to `.env.local` and fill in your real keys.
# The script reads `.env` / `.env.local` automatically.

# Xiaomi MiMo
MIMO_API_KEY=replace-with-your-real-key
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1

# GeekAI /audio/speech
GEEKAI_API_KEY=replace-with-your-real-key
GEEKAI_API_BASE_URL=https://geekai.co/api/v1

# NewAPI /v1/audio/speech
NEWAPI_API_KEY=replace-with-your-real-key
NEWAPI_API_BASE_URL=https://your-newapi-server-address

# Generic OpenAI-compatible /v1/audio/speech provider
OPENAI_AUDIO_API_KEY=replace-with-your-real-key
OPENAI_AUDIO_API_BASE_URL=https://your-openai-compatible-server-address
